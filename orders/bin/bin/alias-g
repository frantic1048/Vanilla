#!/usr/bin/env nu

const date_relative = '--date=relative'
const oneline = '--pretty=oneline'

const git_shortcuts = {
  a: [add]
  ap: [apply]
  bl: [blame]
  bll: [blame -w -C]
  c: [commit]
  cn: [commit -n]
  cm: [commit -m]
  cnm: [commit -n -m]
  ck: [checkout]
  ckb: [checkout -b]
  'ck-': [checkout -]
  ckm: [checkout master]
  sw: [switch]
  swc: [switch -c]
  'sw-': [switch -]
  cp: [cherry-pick]
  cpc: [cherry-pick --continue]
  cpa: [cherry-pick --abort]
  dh: [diff HEAD]
  dhc: [diff HEAD --cached]
  fe: [fetch]
  p: [push]
  P: [push --force-with-lease --force-if-includes]
  PP: [push --force]
  pl: [pull]
  pd: [push --delete origin]
  mt: [maintenance]
  m: [merge]
  rb: [rebase]
  rbo: [rebase --onto]
  rbi: [rebase -i]
  rbio: [rebase -i --onto]
  rboi: [rebase -i --onto]
  rbbi: [rebase --rebase-merges -i]
  rba: [rebase --abort]
  rbc: [rebase --continue]
  rbs: [rebase --skip]
  ama: [am --abort]
  amc: [am --continue]
  ams: [am --skip]
  summary: [shortlog -sne]
  rp: [rev-parse --show-toplevel]
  rs: [reset]
  rs1: [reset 'HEAD~1']
  rsu: [reset --hard '@{u}']
  so: [show -q $oneline]
  tu: [status]
  ta: [stash]
  rl: [reflog]
  tr: [log --graph --abbrev-commit $date_relative --decorate=short --single-worktree]
  trr: [log --graph --abbrev-commit $date_relative --decorate=short --all]
  to: [log --graph --abbrev-commit $date_relative --decorate=short $oneline --single-worktree]
  too: [log --graph --abbrev-commit $date_relative --decorate=short $oneline --all]
  lp: [log '--format=%Cgreencommit %H%Creset%n%B']
  wt: [worktree]
}

# Field names: https://git-scm.com/docs/git-for-each-ref#_field_names
const branch_fields = [
  head hash branch worktree track upstream author date
]
const branch_format = [
  '%(HEAD)' '%(objectname:short)' '%(refname:short)' '%(worktreepath)'
  '%(upstream:track,nobracket)' '%(upstream)' '%(authorname)' '%(committerdate:iso-strict)'
]

def paint [style: any, text: string] {
  $"(ansi $style)($text)(ansi reset)"
}

# Where another worktree has the branch checked out, shown under the branch.
# Siblings in the same collection show as their directory name, shortened to
# `@<task>` for this repository's own `<key>@<task>` workspaces.
def worktree-label [worktree: string, home: string] {
  let name = ($worktree | path basename)
  if ($worktree | path dirname) == ($home | path dirname) {
    let own = $"($home | path basename)@"
    if ($name | str starts-with $own) { $name | str substring (($own | str length) - 1).. } else { $name }
  } else if ($worktree | str starts-with $"($nu.home-dir)/") {
    $"~($worktree | str substring ($nu.home-dir | str length)..)"
  } else {
    $worktree
  }
}

def track-label [track: string, upstream: string] {
  if ($upstream | is-empty) { return "" }
  if $track == 'gone' { return (paint yellow_bold gone) }
  if ($track | is-empty) { return '=' }
  $track | split row ', ' | each {|part|
    let p = ($part | parse '{dir} {n}' | first)
    if $p.dir == 'ahead' { paint green_bold $"⇡($p.n)" } else { paint red_bold $"⇣($p.n)" }
  } | str join ' '
}

# Local branches, oldest commit first: hash (* marks this worktree's branch),
# branch with the other worktree holding it, upstream track, author, date.
# Avoid dark_gray: bright black is nearly invisible on the dark WezTerm palette.
def branch-rows [] {
  let here = (^git rev-parse --show-toplevel | str trim)
  let common = (^git rev-parse --path-format=absolute --git-common-dir | str trim)
  let home = ($common | path dirname)
  ^git for-each-ref --sort=committerdate $"--format=($branch_format | str join '%00')" refs/heads/
  | lines
  | split column (char nul) ...$branch_fields
  | each {|r|
    let elsewhere = ($r.worktree | is-not-empty) and $r.worktree != $here
    let marker = if $r.head == '*' { paint green_bold '*' } else { ' ' }
    let branch = (paint {fg: light_blue, attr: bi} $r.branch)
    {
      current: ($r.head == '*')
      hash: $"($marker) (paint {fg: red, attr: d} $r.hash)"
      branch: (if $elsewhere { $"($branch)\n(paint yellow $'↳ (worktree-label $r.worktree $home)')" } else { $branch })
      track: (track-label $r.track $r.upstream)
      author: $r.author
      date: ($r.date | into datetime)
    }
  }
}

def branch-table [] {
  branch-rows | reject current | table --index false
}

# The most recent branches plus the current one, wherever it sorts.
def recent-branch-table [count: int] {
  let rows = (branch-rows)
  let first_recent = ($rows | length) - $count
  $rows
  | enumerate
  | where {|it| $it.item.current or $it.index >= $first_recent }
  | get item
  | reject current
  | table --index false
}

# Lines added/removed against HEAD per path, staged and unstaged together.
def diff-counts [] {
  let r = (^git diff --numstat --no-renames -z HEAD | complete)
  if $r.exit_code != 0 { return {} }
  $r.stdout
  | split row (char nul)
  | compact --empty
  | parse "{added}\t{removed}\t{path}"
  | reduce --fold {} {|it, acc| $acc | insert $it.path {added: $it.added, removed: $it.removed} }
}

def diff-label [counts: any] {
  if $counts == null { return "" }
  if $counts.added == '-' { return 'binary' }
  [
    (if $counts.added != '0' { paint green $"+($counts.added)" })
    (if $counts.removed != '0' { paint red $"-($counts.removed)" })
  ] | compact | str join ' '
}

# Working tree status like `git status -s`: staged code green, unstaged red,
# renames as `old → new`, with line counts against HEAD.
def status-table [] {
  let tokens = (^git status --porcelain=v1 -z | split row (char nul) | compact --empty)
  let counts = (diff-counts)
  mut rows = []
  mut i = 0
  while $i < ($tokens | length) {
    let entry = ($tokens | get $i)
    let x = ($entry | str substring 0..0)
    let y = ($entry | str substring 1..1)
    let path = ($entry | str substring 3..)
    $i += 1
    # Renames and copies are followed by their source path.
    let shown = if $x in [R C] or $y in [R C] {
      let source = ($tokens | get $i)
      $i += 1
      $"($source) → ($path)"
    } else {
      $path
    }
    let code = if $entry starts-with '??' {
      paint red '??'
    } else {
      $"(paint green $x)(paint red $y)"
    }
    $rows = ($rows | append {st: $code, path: $shown, diff: (diff-label ($counts | get -o $path))})
  }
  if ($rows | is-empty) { return null }
  $rows | table --index false
}

def launch-background [command: string, args: list<string>] {
  # Detach from alias-g itself so GUI commands also survive calls from Nushell,
  # Bash, and Zsh wrappers.
  ^sh -c 'nohup "$@" >/dev/null 2>&1 &' sh $command ...$args
}

def can-fast-forward [refs: list<string>]: nothing -> bool {
  let merge_base = (^git merge-base HEAD ...$refs | str trim)
  let head = (^git rev-parse HEAD | str trim)
  $merge_base == $head
}

def show-working-copy [] {
  let files = (
    ^git status --porcelain=v1 -z
    | split row (char nul)
    | compact --empty
    | where {|entry| ($entry | str length) >= 4 }
    | each {|entry| $entry | str substring 3.. }
    | where {|file| $file | path exists }
    | each {|file| ls -D $file }
    | flatten
    | sort-by modified --reverse
    | get name
  )

  for file in $files {
    ^git diff -U1 -w --color HEAD -- $file
  }
}

def run-g [args: list<string>] {
  if ($args | is-empty) {
    # Quick overview: recent branches, then the working tree.
    print (recent-branch-table 5)
    let status = (status-table)
    if $status != null { print $status }
    return
  }

  let op = $args.0
  let rest = ($args | skip 1)

  if $op in $git_shortcuts {
    let command = ($git_shortcuts | get $op)
    ^git ...$command ...$rest
    return
  }

  match $op {
    'b' => {
      if ($rest | is-empty) {
        print (branch-table)
      } else {
        ^git branch ...$rest
      }
    }
    'cnmw' => {
      ^git add .
      if $env.LAST_EXIT_CODE == 0 {
        ^git commit -n --allow-empty -m '[skip ci] wip'
      }
    }
    'f' => {
      let message = ($rest | str join ' ')
      ^git commit -n --fixup $":/($message)"
    }
    'ff' => { ^git commit -n --fixup ...$rest }
    'body' => {
      let refs = if ($rest | is-empty) { [HEAD] } else { $rest }
      ^git rev-list --max-count=1 --no-commit-header '--format=%B' ...$refs
    }
    'cb' => { ^git rev-parse --abbrev-ref HEAD }
    'dt' => { ^git -c diff.external=difft diff ...$rest }
    'wc' => { show-working-copy }
    'g' => { launch-background git ([gui] | append $rest) }
    'k' => { launch-background gitk $rest }
    'ka' => { launch-background gitk ([--all] | append $rest) }
    'loc' => {
      let files = (^git ls-files | lines)
      ^cloc ...$files ...$rest
    }
    'pu' => {
      let branch = (^git rev-parse --abbrev-ref HEAD | str trim)
      ^git push -u origin $branch ...$rest
    }
    'mf/' => { can-fast-forward $rest }
    'mf' => {
      if (can-fast-forward $rest) {
        ^git merge --no-ff ...$rest
      } else {
        print 'outdated branch !'
      }
    }
    'rbm' => { ^git rebase ...$rest master }
    'rbim' => { ^git rebase -i ...$rest master }
    _ => { ^git ...$args }
  }
}

# Interactive shells import this command without starting another Nushell.
export def --wrapped g [...args: string] {
  run-g $args
}

# Other interactive shells call the namespaced executable through a thin `g`
# wrapper, keeping the one-letter name out of the global executable namespace.
def --wrapped main [...args: string] {
  g ...$args
  let exit_code = $env.LAST_EXIT_CODE
  if $exit_code != 0 {
    exit $exit_code
  }
}
