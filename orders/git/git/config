# https://git-scm.com/docs/git-config#FILES
# Order:
#  ~/.config/git/config (this file, host-independent user settings, managed by this repo)
#  ~/.gitconfig (host-specific user settings: maintenance, credential..., not managed by this repo)
[user]
	name = Jiahao Guo
	email = im@pyonpyon.today
	signingkey = 22D8A46B2CDA6605A1C0CFD1E060B3E215CE49BB
[includeIf "gitdir:~/work/"]
    path = config.user.work
[core]
	# `helm plugin install ...` ridiculously need this off otherwise boom (°_°)
	# https://github.com/helm/helm/issues/12125
	fsmonitor = true

	pager = "if command -v delta &>/dev/null; then delta; else less; fi"
	precomposeunicode = true
	quotepath = false
[safe]
	# Ignore bare repositories found by walking up from cwd. A repo can commit
	# a bare repo as plain files, and its config could make git run commands
	# when you cd into it. Use --git-dir to work with a bare repo on purpose.
	bareRepository = explicit
[transfer]
	# Validate objects on fetch/clone/push receive, rejecting malformed trees
	# and .gitmodules tricks before they land. Old repos with historical fsck
	# errors fail the fetch; skip that check in the one repo with
	# `git config fetch.fsck.<msgId> ignore`, or at clone time with
	# `git clone -c fetch.fsck.<msgId>=ignore ...` (fsck.<msgId> doesn't apply).
	fsckObjects = true
[feature]
	manyFiles = true
[diff]
	algorithm = histogram
	colorMoved = default
[commit]
	gpgsign = false
[merge]
	ff = only
	conflictStyle = zdiff3
[push]
	default = simple
	autoSetupRemote = false
[fetch]
	writeCommitGraph = true
[pull]
	ff = only
[rebase]
	autoSquash = true
	instructionFormat = "%aN\t%s"
[branch]
	autoSetupMerge = simple
[http]
	postBuffer = 1048576000

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# external tools
[delta]
	theme = OneHalfDark
	line-numbers = false
	keep-plus-minus-markers = true