{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group all Docker image updates",
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker-images"
    },
    {
      "description": "Group blend updates (CI container image + repo .prototools) and automerge",
      "matchPackageNames": [
        "ghcr.io/frantic1048/blend",
        "frantic1048/blend"
      ],
      "groupName": "blend",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "blend in the repo .prototools (custom proto plugin, unsupported by the proto manager)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.prototools$/"
      ],
      "matchStrings": [
        "blend = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "frantic1048/blend",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^blend-v(?<version>.+)$"
    }
  ]
}
